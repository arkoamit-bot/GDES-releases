# ==========================================================================
#  GDES / BGDDR — .gitignore
#  CRITICAL: never commit patient data (SQLite DBs, backups, media, exports).
# ==========================================================================

# Python
__pycache__/
venv/
.venv/
*.py[cod]
.pytest_cache/
*.egg-info/

# --- Patient data & runtime state (NEVER commit) --------------------------
*.sqlite3
*.sqlite3.*
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
db-*.sqlite3
*.bak
*.backup
*.dump
/Backups/
/Logs/
/Media/
/media/
/Exports/
# Git matches ignore patterns case-insensitively on Windows (core.ignorecase),
# so /Exports/ above also swallowed the `exports` Django app. Track its Python
# source only; runtime export files never get a .py suffix.
!/exports/
/exports/**
!/exports/**/
!/exports/**/*.py
/Imports/
/Temp/
.initialized
.shortcut_done
.kb_version
bgddr_paths.json

# --- Secrets --------------------------------------------------------------
.env
.secret_key
# Code-signing private keys must NEVER be committed (public .cer is fine).
*.pfx
*.p12
*.key
# Bundled Microsoft WebView2 bootstrapper (re-downloadable; not source).
desktop/installer/MicrosoftEdgeWebview2Setup.exe

# --- Node / front-end build ----------------------------------------------
node_modules/

# --- Django collected static (regenerated by collectstatic) ---------------
/staticfiles/

# --- Desktop build artifacts ---------------------------------------------
/dist/
/build/
/build_onefile/

# --- Misc / editor / OS ---------------------------------------------------
.Rhistory
.DS_Store
Thumbs.db
.claude/settings.local.json

# OneDrive conflict copies. Syncing this folder from two machines renames the
# loser with a device suffix — "launcher-Dr-Wasim.py", and "-Dr-Wasim-2.py" for
# the second collision. The old pattern (*-Dr-Wasim.*) missed the numbered
# variants, so one of them was committed. Add a line per device that syncs
# this folder.
*-Dr-Wasim*
*-Home*

# Keep the COMPILED stylesheet (static/css/app.css) and vendored JS committed so
# the app runs without a Node build; only re-run `npm run build:css` when the
# templates/CSS change.

# Build logs
build_pyinstaller.log

# Stray test/validation output dumps
test_output.txt
test_results_fixed.txt
validation_output.txt
*_output.txt

# Patient-data exports must never be tracked
patient_issues.csv
*_issues.csv
PATIENT_*.csv
