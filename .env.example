# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
DJANGO_DEBUG=0
DJANGO_SETTINGS_MODULE=bgddr.settings_prod

# PostgreSQL
POSTGRES_DB=bgddr
POSTGRES_USER=bgddr
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security (optional, recommended)
# HTTPS is terminated at nginx; set to True if behind HTTPS
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

# Transport security — MUST be enabled for any deployment reachable over a
# network (LAN or internet). Leave unset/False ONLY for the single-user desktop
# build, which serves plain HTTP on 127.0.0.1.
# Enable these only after confirming HTTPS works end-to-end: HSTS is sticky and
# a mistake can lock browsers out of the app for a year. Startup aborts if
# DJANGO_HSTS_SECONDS is set without DJANGO_SECURE_SSL, because HSTS is only
# delivered over HTTPS and the combination could never take effect.
# Verify with: python manage.py check --deploy --settings=bgddr.settings_deploy
# DJANGO_SECURE_SSL=True
# DJANGO_HSTS_SECONDS=31536000

# Vera Health Clinical AI Integration
# Option 1: Enterprise API (when api.verahealth.ai is deployed)
# VERAHEALTH_API_KEY=your-api-key-here
# VERA_API_BASE_URL=https://api.verahealth.ai/v1

# Option 2: Web session auth (requires Vera Health account)
# Configure via: python manage.py seed_vera_web_provider
# Or set these environment variables:
# VERA_SUPABASE_ANON_KEY=your-supabase-anon-key
# VERA_WEB_BASE_URL=https://verahealth.ai
